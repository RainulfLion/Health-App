# Server Configuration
PORT=3001

# Garmin API (optional - can also be set via the UI)
# Get your credentials from https://developer.garmin.com/
GARMIN_CONSUMER_KEY=your_consumer_key_here
GARMIN_CONSUMER_SECRET=your_consumer_secret_here

# Database
# SQLite database will be created at backend/data/health.db by default

# File Upload
# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# CORS (if deploying to different domains)
# CORS_ORIGIN=http://localhost:3000
